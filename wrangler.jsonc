{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nexusnxs-site",
  "account_id": "7d844e420d105a64adc45a165e4cd8f6",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-08-22",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": true,
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "routes": [
    {
      "pattern": "nexusnxs.com",
      "custom_domain": true
    },
    {
      "pattern": "www.nexusnxs.com",
      "custom_domain": true
    },
    {
      "pattern": "ai.nexusnxs.com/*",
      "zone_name": "nexusnxs.com"
    }
  ],
  "d1_databases": [
    {
      "binding": "UPDATE_HEALTH",
      "database_name": "nexusnxs-update-health",
      "database_id": "098fd77b-09e9-47fa-b820-801945aeeb98"
    }
  ],
  "assets": {
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "vars": {
    "NEXUSNXS_SITE_MODE": "live"
  },
  "observability": {
    "enabled": true
  }
}
