<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.NexusRemote" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowBackground">@color/nexus_background</item>
        <item name="android:colorAccent">#62D5D2</item>
        <item name="android:scrollbars">none</item>
        <item name="android:windowNoTitle">true</item>
    </style>
    <style name="Theme.NexusRemote.Assistant" parent="Theme.NexusRemote">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowDisablePreview">true</item>
        <item name="android:windowContentTransitions">false</item>
    </style>
</resources>
