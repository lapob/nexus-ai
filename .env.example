# NEXUS reads environment variables from the process environment.
# This file is documentation only: no dotenv package is required or loaded.

# Optional absolute path to the Obsidian vault. By default Nexus uses the
# relative layout declared in config/portable.json.
NEXUS_VAULT_PATH=

# Maintainer-only portable toolchains. Relative values are resolved from the
# NexusNXS workspace, so the same SSD can receive a different drive letter.
NEXUS_DEVELOPER_HOME=
NEXUS_TOOLCHAINS_HOME=
NEXUS_ANDROID_SDK=
NEXUS_GRADLE_HOME=
NEXUS_GRADLE_USER_HOME=
NEXUS_JAVA_HOME=
NEXUS_OLLAMA_MODELS=
NEXUS_OLLAMA_EXECUTABLE_PATH=

# Provider-independent AI runtime. Internet hosts are rejected; una workstation
# RFC1918 in LAN richiede opt-in esplicito.
NEXUS_AI_PROVIDER=ollama
NEXUS_OLLAMA_BASE_URL=http://127.0.0.1:11434
NEXUS_OLLAMA_ALLOW_LAN=0
NEXUS_OLLAMA_TIMEOUT_MS=120000
NEXUS_AI_AUTO_SELECT=1
NEXUS_AI_CHAT_MODEL=qwen3:14b
NEXUS_AI_FAST_MODEL=qwen3:8b
NEXUS_AI_EMBEDDING_MODEL=qwen3-embedding:0.6b
NEXUS_LLM_TEMPERATURE=0.3

# Public desktop/Android clients use this HTTPS origin and never download a
# model. Leave empty in source control; set the production domain for release.
NEXUS_DISTRIBUTION_MODE=developer
NEXUS_SERVICE_URL=https://ai.nexusnxs.com
NEXUS_SERVICE_FALLBACK_URLS=https://nxs-core-01.<TAILNET>.ts.net:8443
NEXUS_UPDATE_URL=
NEXUS_RELEASE_CHANNEL=preview
NEXUS_LOCAL_CRASH_REPORTS=1
NEXUS_SERVICE_TIMEOUT_MS=120000

# Ricerca web server-side. I client pubblici non ricevono mai credenziali e
# non eseguono direttamente la ricerca. Senza chiave, auto usa il fallback
# pubblico Wikipedia; Brave abilita una ricerca web generale.
NEXUS_WEB_SEARCH_MODE=auto
NEXUS_WEB_SEARCH_PROVIDER=auto
NEXUS_BRAVE_SEARCH_API_KEY=
NEXUS_WEB_SEARCH_TIMEOUT_MS=6000

# Generazione immagini server-side OpenAI-compatible. Il valore deve puntare
# direttamente a /v1/images/generations. Le credenziali non entrano nei client.
NEXUS_IMAGE_API_URL=
NEXUS_IMAGE_API_KEY=
NEXUS_IMAGE_MODEL=
NEXUS_IMAGE_TIMEOUT_MS=90000

# Release Windows firmata. Conservare certificato e password fuori dal
# repository e valorizzarli soltanto nella CI o nella shell di release.
CSC_LINK=
CSC_KEY_PASSWORD=
# Firma Ed25519 distaccata delle distinte di aggiornamento. Indicare percorsi
# a chiavi custodite fuori dal repository oppure PEM forniti dalla CI.
NEXUS_RELEASE_MANIFEST_PRIVATE_KEY=
NEXUS_RELEASE_MANIFEST_PUBLIC_KEY=
NEXUS_RELEASE_MANIFEST_KEY_ID=

# Gate Stable: ogni valore va impostato a true soltanto dopo una prova reale e
# registrata fuori dal repository. Il report di penetration test è un percorso
# a un file indipendente recente, non un'autocertificazione prodotta dal progetto.
NEXUS_OFFSITE_BACKUP_CONFIRMED=false
NEXUS_UPS_CONFIRMED=false
NEXUS_NETWORK_FAILOVER_CONFIRMED=false
NEXUS_KEY_ROTATION_CONFIRMED=false
NEXUS_CLEAN_DEVICE_UPGRADE_CONFIRMED=false
NEXUS_INCIDENT_REHEARSAL_CONFIRMED=false
NEXUS_EXTERNAL_PENTEST_REPORT=

# error | warn | info | debug
NEXUS_LOG_LEVEL=info
# Dominio HTTPS pubblico esatto autorizzato per Nexus, per esempio
# https://app.example.com. Se assente, restano ammessi soltanto i domini *.ts.net.
NEXUS_PUBLIC_URL=https://ai.nexusnxs.com

# Android build endpoints (HTTPS). Keep real device and tailnet addresses local.
NEXUS_URL=https://ai.nexusnxs.com
NEXUS_CONSOLE_URL=https://nxs-core-01.<TAILNET>.ts.net/console
NEXUS_FALLBACK_URL=https://nxs-core-01.<TAILNET>.ts.net:8443
NEXUS_LAN_URL=

# Optional private maintainer tooling. Format: Area=absolute path;Area=path
NEXUS_PRIVATE_VAULT_PATH=
NEXUS_TOOL_ROOTS=
