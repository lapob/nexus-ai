# NEXUS reads environment variables from the process environment.
# This file is documentation only: no dotenv package is required or loaded.

# Optional absolute path to the Obsidian vault. By default Nexus uses ../.
NEXUS_VAULT_PATH=

# Local OpenAI-compatible endpoint. Remote hosts are rejected.
NEXUS_LLM_BASE_URL=http://127.0.0.1:11434/v1
NEXUS_LLM_MODEL=qwen2.5:7b
NEXUS_LLM_TEMPERATURE=0.3

# error | warn | info | debug
NEXUS_LOG_LEVEL=info

