{
  "name": "nexusnxs-site",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "node scripts/clean-build.mjs && cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "check": "vinext check",
    "test": "npm run lint && npm run typecheck && npm run build && node --test tests/*.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern .wrangler",
    "typecheck": "tsc --noEmit --incremental false",
    "verify:security": "npm audit signatures && npm audit --audit-level=high --omit=optional",
    "verify:release": "npm run check && npm run verify:security && npm test && npm run cloudflare:dry-run",
    "verify:deployment": "node scripts/verify-deployment.mjs",
    "cloudflare:dry-run": "wrangler deploy --config dist/server/wrangler.json --dry-run --outdir .wrangler/dry-run",
    "cloudflare:credential:store": "node scripts/cloudflare-credential.mjs store",
    "cloudflare:credential:status": "node scripts/cloudflare-credential.mjs status",
    "release:bootstrap": "node scripts/cloudflare-release.mjs bootstrap",
    "release:prepare": "node scripts/cloudflare-release.mjs prepare",
    "release:activate-initial": "node scripts/cloudflare-release.mjs activate-initial",
    "release:cutover": "node scripts/cloudflare-release.mjs cutover",
    "release:promote": "node scripts/cloudflare-release.mjs promote",
    "release:rollback": "node scripts/cloudflare-release.mjs rollback"
  },
  "dependencies": {
    "lucide-react": "^1.31.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.53.1",
    "@eslint/js": "9.39.4",
    "@napi-rs/keyring": "1.3.0",
    "@next/eslint-plugin-next": "16.2.6",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.34",
    "cross-env": "^10.1.0",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vinext": "1.0.0-beta.8",
    "vite": "8.2.2",
    "wrangler": "4.125.0"
  },
  "type": "module"
}
